[Unit]
Description=Selenite first-boot setup
After=systemd-logind.service
ConditionPathExists=!/var/lib/selenite-setup-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/selenite-first-boot
ExecStartPost=/usr/bin/touch /var/lib/selenite-setup-done
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target