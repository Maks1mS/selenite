{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "security:openssf-scorecard",
        "schedule:nonOfficeHours",
        "local>alt-atomic/renovate:common-actions"
    ],
    "packageRules": [
        {
            "description": "Do not update by digest with same tag",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "golang"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "enabled": false
        },
        {
            "description": "Update core-minimal only once per week (on Monday)",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "altlinux.space/alt-atomic/core-minimal/stable"
            ],
            "schedule": [
                "* * * * 1"
            ],
            "semanticCommitType": "fix",
            "semanticCommitScope": ""
        }
    ],
    "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
    ]
}
