FROM altlinux.space/alt-atomic/core/stable:20260305@sha256:0ca8633b0d8a7167ac486685c5e3bfbf65db82994d5087fd9f7e1d1244b0385e as base

ARG DEV

ENV DEV=$DEV

RUN --mount=type=bind,source=./base/image.yml,target=/etc/apm/image.yml \
    --mount=type=bind,source=./base/resources,target=/etc/apm/resources \
    apm system image build

RUN --mount=type=bind,source=./image.yml,target=/etc/apm/image.yml \
    --mount=type=bind,source=./resources,target=/etc/apm/resources \
    apm system image build

WORKDIR /
CMD ["/sbin/init"]

